# ============================================================
# 环境变量模板 — 复制为 .env 并填入真实值
# ============================================================

# LLM 配置 (必填)
# OpenAI 兼容接口
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=http://xxx/v1
LLM_MODEL_NAME=qwen-max

# OTel 认证 Token (生产环境必填)
OTEL_TOKEN=your-otel-token

# OTel 消息渠道 Resource tag（可选，默认 web；接入飞书/微信时按独立部署设置）
# OTEL_CHANNEL=web

# PostgreSQL (docker 容器 postgres-dev)
DATABASE_URL=postgresql://user:password@localhost:5432/ragdb
# MySQL 8.0+ 示例（二选一；URL scheme 自动推断后端，需带库名）
# DATABASE_URL=mysql://user:password@localhost:3306/platform

# Redis (docker 容器 redis-dev)
REDIS_URL=redis://localhost:6379/0

# ModelScope MCP (可选)
MODELSCOPE_API_KEY=

# 百度地图 MCP (可选)
BAIDU_MAPS_API_KEY=

# 应用环境: dev / prod
APP_ENV=dev
