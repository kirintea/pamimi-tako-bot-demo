# ============================================================
# 环境变量模板 — 复制为 .env 并填入真实值
# ============================================================

# LLM 配置 (必填)
# OpenAI 兼容接口
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=http://xxx/v1
LLM_MODEL_NAME=qwen-max

# OTel 认证 Token (生产环境必填)
OTEL_TOKEN=your-otel-token

# PostgreSQL (docker 容器 postgres-dev)
DATABASE_URL=postgresql://user:password@localhost:5432/ragdb

# Redis (docker 容器 redis-dev)
REDIS_URL=redis://localhost:6379/0

# ModelScope MCP (可选)
MODELSCOPE_API_KEY=

# 百度地图 MCP (可选)
BAIDU_MAPS_API_KEY=

# 应用环境: dev / prod
APP_ENV=dev
