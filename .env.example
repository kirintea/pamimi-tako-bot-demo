# ============================================================
# 环境变量模板 — 复制为 .env 并填入真实值
# ============================================================
# 加载机制：
#   - main.py 启动时 load_dotenv() 自动加载 .env（override=False，
#     已存在的环境变量优先，如 Docker 注入的配置）
#   - health_check/* 加载时 override=True（.env 覆盖外部环境变量）
# 标注说明：
#   - 带 * 标记的为必填项
#   - 「仅 dev.yaml / 仅 prod.yaml」表示变量只被对应环境的 YAML 引用
# YAML 中 ${VAR:-default} 语法：未设置时使用 default；
# 无 default 的占位符未设置时启动 fail-fast（可设 ALLOW_UNRESOLVED_ENV=1 降级告警）

# ============================================================
# 1. 应用环境
# ============================================================
# 选择加载哪个配置文件：configs/{APP_ENV}.yaml
APP_ENV=dev                           # dev / prod

# 允许未解析的环境变量占位符不报错（仅开发调试用，生产勿设）
# ALLOW_UNRESOLVED_ENV=1

# ============================================================
# 2. LLM 配置（* 必填）
# ============================================================
# OpenAI 兼容接口（支持 OpenAI / DashScope / vLLM / Ollama 等）
LLM_API_KEY=your-llm-api-key         # * API 密钥（无默认值，必须设置）
LLM_BASE_URL=http://xxx/v1           # * 接口地址（无默认值，必须设置）
LLM_MODEL_NAME=qwen-max              # * 模型名称（dev 默认 qwen-max；prod 无默认值，必须显式指定）

# ============================================================
# 3. 数据库（* 生产必填，dev 默认连本地 PostgreSQL）
# ============================================================
# PostgreSQL 或 MySQL 连接串（URL scheme 自动推断后端）
#   PostgreSQL: postgresql://user:password@host:5432/dbname
#   MySQL:      mysql://user:password@host:3306/dbname（>= 8.0.20，推荐 8.0.26+）
# prod.yaml 中默认值为空串 —— 未设置时跳过数据库初始化（/mcp /skill 等路由返回 503）
DATABASE_URL=postgresql://user:password@localhost:5432/dmx_agent_db

# MySQL 健康检查/集成测试专用（不设则用 DATABASE_URL）
# TEST_MYSQL_URL=mysql://user:password@localhost:3306/platform

# ============================================================
# 4. Redis（* 生产必填，dev 默认连本地）
# ============================================================
# 会话 KV（kv.backend=redis 时）+ 分布式消息总线
REDIS_URL=redis://localhost:6379/0

# ============================================================
# 5. KV 存储后端（仅 dev.yaml，默认 redis）
# ============================================================
# 会话状态/元数据持久化层：redis（多实例/生产）或 jsonl（单进程开发）
# prod.yaml 固定 backend=redis，以下两个变量在 prod 下不生效
# KV_BACKEND=redis                    # redis / jsonl
# KV_JSONL_PATH=workspaces/.history/kv_data

# ============================================================
# 6. API 认证（可选，生产建议开启）
# ============================================================
# 启用后 HTTP 请求须携带请求头 X-API-Key: <API_KEY>
# （不是 Authorization: Bearer；/webui、/health、/docs 等公开路径豁免）
#
# AUTH_REQUIRED 环境变量优先于 YAML auth.required：
#   =true  强制开启    =false 强制关闭    未设置时按 YAML（prod 默认开启）
# 注意：
#   - 开启认证时 API_KEY 必须非空，否则所有请求都会 401
#   - WebSocket /ws/chat 只认 AUTH_REQUIRED=true（不读 YAML），启用首帧认证
#     {"type":"auth","payload":{"api_key":"<API_KEY>"}}；生产需显式设置
# API_KEY=
# AUTH_REQUIRED=false

# ============================================================
# 7. OTel 追踪（可选，默认关闭）
# ============================================================
# OTEL_ENDPOINT 仅 dev.yaml 引用（prod 的 endpoint 写死在 prod.yaml）
# OTEL_ENDPOINT=http://localhost:4317  # OTLP gRPC 上报地址

# 消息渠道 Resource tag，多渠道部署时按实例区分（web / feishu / wechat）
# OTEL_CHANNEL=web

# OTel 认证 Token —— 仅 prod.yaml 引用，且无默认值：
# APP_ENV=prod 时必须设置，否则启动 fail-fast
# OTEL_TOKEN=your-otel-token

# ============================================================
# 8. 权限与渠道媒体（可选）
# ============================================================
# root 用户 ID（逗号分隔），与 YAML agent.root_user_ids 合并；
# root 可写 agent_space 并只读查看他人会话
# ROOT_USER_IDS=

# 渠道入站媒体落盘目录（当前企业微信适配器使用；默认 data/channels/media）
# CHANNEL_MEDIA_DIR=data/channels/media

# ============================================================
# 9. 配置文件路径覆盖（可选，默认 configs/ 下对应文件）
# ============================================================
# MCP / Skill / 渠道的唯一真源是 JSON 配置文件（热加载），凭据写在文件内，
# 不经过 .env：
#   configs/mcps.json      — MCP 服务配置（含 Bearer token；已 gitignore）
#   configs/skills.json    — 技能元数据（已 gitignore）
#   configs/channels.json  — 渠道凭据（已 gitignore）
# 仅当文件不在默认位置时才需要覆盖路径（建议写绝对路径）：
# MCPS_CONFIG_PATH=configs/mcps.json
# SKILLS_CONFIG_PATH=configs/skills.json
# CHANNELS_CONFIG_PATH=configs/channels.json
# 注意：启动时读取一次即定死（须经 main.py 入口加载 .env），运行中改无效；
#       相对路径按当前工作目录解析。SKILLS_CONFIG_PATH 只管元数据，
#       运行时技能仍从 agent_space/skills/ 或 skills/ 加载（agent.sandbox_skills）。

# ============================================================
# 10. 对象存储（可选，默认 local 本地存储）
# ============================================================
# 注意：需同时在 configs/{APP_ENV}.yaml 的 object_storage 中启用对应键，
# 环境变量才会被引用（dev.yaml 中这些键当前为注释状态；prod.yaml 无此配置节）
#
# --- S3 后端（AWS S3 / MinIO / Cloudflare R2）---
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=agentscope-images
# S3_REGION=us-east-1

# --- 阿里云 OSS ---
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_BUCKET=agentscope-images

# ============================================================
# 11. 沙箱（可选，默认 local 本机执行）
# ============================================================
# 仅 prod.yaml 引用（dev.yaml 当前硬编码 backend: "docker"）
# SANDBOX_BACKEND=local               # local / docker
# 沙箱容器名由 YAML sandbox.container 配置；
# docker-compose 中的 SANDBOX_CONTAINER 环境变量当前未被应用读取

# ============================================================
# 12. 自定义工具（按需）
# ============================================================
# configs/tools.yaml 的 custom_tools 示例（WebSearch）会引用此变量，
# 取消注释示例工具时才需要设置：
# SEARCH_API_KEY=
