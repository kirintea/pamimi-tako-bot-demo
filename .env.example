# ════════════════════════════════════════════════════════════════════════════
#  环境变量模板 · .env.example —— 与 .env 结构逐节一致（脱敏版）
# ════════════════════════════════════════════════════════════════════════════
#
#  ┌─ 怎么用（新人看这几行就够了）─────────────────────────────────┐
#  │ ① 复制本文件为 .env：   cp .env.example .env                  │
#  │ ② 填好下面【必填】的 3 个 LLM 变量（第 2 节）→ 就能启动了     │
#  │ ③ 其他变量全部可选，不填走默认值；想接数据库/Redis 再看第 3、4 节 │
#  └────────────────────────────────────────────────────────────────┘
#
#  启动： APP_ENV=dev python main.py   （或 ./scripts/start.sh）
#  验证： 浏览器打开 http://localhost:8090/webui
#
#  ── 阅读约定 ────────────────────────────────────────────────
#   【必填】没设置会启动失败       【推荐】默认能跑，但建议按环境改
#   【可选】不改就用默认值         ⚠       易踩坑，值得读完
#
#  ── 两条通用规则 ────────────────────────────────────────────
#   1. 本文件会被 configs/{APP_ENV}.yaml 用 ${VAR} 读取：
#        ${VAR:-默认值} = 变量没设置时用默认值；${VAR} = 没设置就直接启动失败
#   2. 值后面可以写 # 注释（前面留空格即可）；
#      ⚠ 但「空值行」（如 DATABASE_URL=）后面不能加注释——会被当成值本身，
#         需要说明时把注释写在上一行。
# ════════════════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════
# 1. 应用环境 —— 选择用哪份配置：configs/{APP_ENV}.yaml
# ════════════════════════════════════════════════════════════
APP_ENV=dev                           # dev / prod

# 【可选】允许未解析的变量占位符不报错（仅调试用，生产勿设）
# ALLOW_UNRESOLVED_ENV=1

# ════════════════════════════════════════════════════════════
# 2. LLM 配置 —— 【必填】对话模型，不填启动不了
# ════════════════════════════════════════════════════════════
# OpenAI 兼容接口（OpenAI / DashScope / vLLM / Ollama / SiliconFlow 等）
LLM_API_KEY=your-llm-api-key          # 【必填】API 密钥
LLM_BASE_URL=http://xxx/v1            # 【必填】接口地址（结尾通常是 /v1）
LLM_MODEL_NAME=qwen-max               # 【必填】模型名（dev 默认 qwen-max；prod 无默认值，必须显式写）

# ════════════════════════════════════════════════════════════
# 3. 数据库 —— 存对话历史 / 用户 / MCP / Skill 配置
#    【可选】本地不装数据库也能跑
# ════════════════════════════════════════════════════════════
# 默认「本地无库测试」模式（空值）：跳过数据库初始化，
# /health 显示 not_configured，对话正常；历史列表 / 消息 / 重命名 / MCP / Skill /
# 统计看板等依赖库的功能返回 503。
# 要启用数据库：注释掉下面这行空值，改用下面任一连接串。
# 账号与 docker/deploy_yml/{postgres,mysql}.yml 的默认值一致：
#   PostgreSQL → user / password / dmx_agent_db
#   MySQL      → user / password / dmx_agent_db（root 是 root123，仅管理用）
DATABASE_URL=
# DATABASE_URL=postgresql://user:password@localhost:5432/dmx_agent_db
# DATABASE_URL=mysql://user:password@localhost:3306/dmx_agent_db

# 【可选】MySQL 连接串，仅供下面两个入口用（主程序不读）：
#   health_check/check_mysql.py、tests/test_mysql_integration.py
# 不设则回退到上面的 DATABASE_URL（需是 mysql:// 开头）。
# TEST_MYSQL_URL=mysql://user:password@localhost:3306/dmx_agent_db

# ════════════════════════════════════════════════════════════
# 4. Redis —— 跨实例消息广播 + 会话存储
#    【可选】本地不启动 Redis 也能跑
# ════════════════════════════════════════════════════════════
# 不启动 Redis 时：消息总线重试 3 次（启动累计慢约 20 秒）后自动降级为进程内总线，
# /health 里 redis 显示 unavailable 但整体仍 ok；降级后失去跨实例广播 / 多端状态同步。
# 当前未设置（走 dev.yaml 默认本地连接，连不上即降级）。
# REDIS_URL=redis://localhost:6379/0

# ════════════════════════════════════════════════════════════
# 5. KV 存储后端 —— 会话"记忆"放哪（仅 dev.yaml 生效）
# ════════════════════════════════════════════════════════════
#   redis — 放 Redis（多实例/生产）   jsonl — 放本地文件（单进程开发，不依赖 Redis）
# ⚠ dev.yaml 当前硬编码 kv.backend=jsonl，KV_BACKEND 暂不生效——
#   只有把 dev.yaml 里那行换成注释里的 ${KV_BACKEND:-redis} 写法后才生效。
KV_BACKEND=jsonl
KV_JSONL_PATH=workspaces/.history/kv_data

# ════════════════════════════════════════════════════════════
# 6. API 认证 —— 给接口加访问钥匙 【推荐生产开启】
# ════════════════════════════════════════════════════════════
# 开启后请求需带请求头 X-API-Key: <API_KEY>（不是 Authorization: Bearer）。
# ⚠ 开启认证时 API_KEY 必须非空；WebSocket /ws/chat 只认 AUTH_REQUIRED=true。
# API_KEY=
AUTH_REQUIRED=false

# ════════════════════════════════════════════════════════════
# 7. OTel 追踪 —— 调用链可视化 【可选，开发默认关】
# ════════════════════════════════════════════════════════════
# OTEL_ENDPOINT=http://localhost:4317
# ⚠ 进程级渠道标签：一个进程一个渠道，不会按消息动态识别。
#   本实例只服务 web，填 web 即可；要接入飞书/微信，需各自独立部署实例并设对应值。
OTEL_CHANNEL=web                       # web / feishu / wechat
# OTEL_TOKEN=your-otel-token            # 仅 prod.yaml 引用，APP_ENV=prod 时必填

# ════════════════════════════════════════════════════════════
# 8. 权限与渠道媒体 【可选】
# ════════════════════════════════════════════════════════════
# ROOT_USER_IDS=
# CHANNEL_MEDIA_DIR=data/channels/media

# ════════════════════════════════════════════════════════════
# 9. 配置文件路径覆盖 【可选，一般不用管】
# ════════════════════════════════════════════════════════════
# MCP / Skill / 渠道的唯一真源是这些 JSON（热加载，凭据在文件内，不经过 .env）：
#   configs/mcps.json / configs/skills.json / configs/channels.json
# 仅当文件不在默认位置时才覆盖路径（建议绝对路径）：
# MCPS_CONFIG_PATH=configs/mcps.json
# SKILLS_CONFIG_PATH=configs/skills.json
# CHANNELS_CONFIG_PATH=configs/channels.json

# ════════════════════════════════════════════════════════════
# 10. 对象存储 —— 图片上传存哪 【可选，默认本地】
# ════════════════════════════════════════════════════════════
# ⚠ 需同时在 configs/{APP_ENV}.yaml 的 object_storage 启用对应键才会被引用。
# --- S3 ---
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=agentscope-images
# S3_REGION=us-east-1
# --- 阿里云 OSS ---
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_BUCKET=agentscope-images

# ════════════════════════════════════════════════════════════
# 11. 沙箱 —— 工具在哪执行 【可选，默认本机】
# ════════════════════════════════════════════════════════════
# 仅 prod.yaml 引用（dev.yaml 当前硬编码 backend: "docker"）
# SANDBOX_BACKEND=local

# ════════════════════════════════════════════════════════════
# 12. 自定义工具 【按需】
# ════════════════════════════════════════════════════════════
# configs/tools.yaml 的 custom_tools 示例（WebSearch）会引用此变量
# SEARCH_API_KEY=
