# ============================================================
# 环境变量模板 — 复制为 .env 并填入真实值
# ============================================================
# 带 * 标记的为必填项，其余均有合理默认值
# YAML 中 ${VAR:-default} 语法：未设置时使用 default

# ============================================================
# 1. 应用环境
# ============================================================
# 选择加载哪个配置文件：configs/{APP_ENV}.yaml
APP_ENV=dev                           # dev / prod

# 允许未解析的环境变量不报错（仅开发调试用，生产勿设）
# ALLOW_UNRESOLVED_ENV=1

# ============================================================
# 2. LLM 配置（* 必填）
# ============================================================
# OpenAI 兼容接口（支持 OpenAI / DashScope / vLLM / Ollama 等）
LLM_API_KEY=your-llm-api-key         # * API 密钥
LLM_BASE_URL=http://xxx/v1           # * 接口地址
LLM_MODEL_NAME=qwen-max              # * 模型名称（prod 无默认值，必须显式指定）

# ============================================================
# 3. 数据库（* 生产必填，dev 默认连本地 PostgreSQL）
# ============================================================
# PostgreSQL 或 MySQL 连接串（URL scheme 自动推断后端）
#   PostgreSQL: postgresql://user:password@host:5432/dbname
#   MySQL:      mysql://user:password@host:3306/dbname（>= 5.7.22）
DATABASE_URL=postgresql://user:password@localhost:5432/dmx_agent_db

# MySQL 健康检查/集成测试专用（不设则用 DATABASE_URL）
# TEST_MYSQL_URL=mysql://user:password@localhost:3306/platform

# ============================================================
# 4. Redis（* 生产必填，dev 默认连本地）
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# 5. KV 存储后端（可选，默认 redis）
# ============================================================
# 会话状态/元数据持久化层：redis（多实例/生产）或 jsonl（单进程开发）
# KV_BACKEND=redis                    # redis / jsonl
# KV_JSONL_PATH=workspaces/.history/kv_data

# ============================================================
# 6. API 认证（可选，生产建议开启）
# ============================================================
# auth.required: true 时校验此 Key（HTTP Header: Authorization: Bearer <key>）
# 代码中 AUTH_REQUIRED=true 可绕过 YAML 直接强制开启
# API_KEY=
# AUTH_REQUIRED=false

# ============================================================
# 7. OTel 追踪（可选，默认关闭）
# ============================================================
# OTEL_ENDPOINT=http://localhost:4317  # OTLP gRPC 上报地址
# OTEL_CHANNEL=web                    # 消息渠道 Resource tag（web / feishu / wechat）

# OTel 认证 Token（仅 prod 需填，写入 headers.authorization）
# OTEL_TOKEN=your-otel-token

# ============================================================
# 8. MCP 服务 API Key（按需填写，对应 configs/dev.yaml mcp_servers）
# ============================================================
# MODELSCOPE_API_KEY=                 # ModelScope MCP
# BAIDU_MAPS_API_KEY=                 # 百度地图 MCP
# DASHSCOPE_API_KEY=                  # DashScope MCP

# ============================================================
# 9. 对象存储（可选，默认 local 本地存储）
# ============================================================
# --- S3 后端（AWS S3 / MinIO / Cloudflare R2）---
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=agentscope-images
# S3_REGION=us-east-1

# --- 阿里云 OSS ---
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_BUCKET=agentscope-images

# ============================================================
# 10. 沙箱（可选，默认 local 本机执行）
# ============================================================
# SANDBOX_BACKEND=local               # local / docker
