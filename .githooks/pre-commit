#!/usr/bin/env bash
# 预提交钩子 —— 拦截含敏感信息的提交
# 检测：内网 IP（RFC1918）、云厂商/常用 API 密钥前缀、私钥块
# 绕过：git commit --no-verify
set -euo pipefail

PATTERN='(192\.168\.|10\.[0-9]{1,3}\.|172\.(1[6-9]|2[0-9]|3[01])\.)[0-9]{1,3}\.[0-9]{1,3}|sk-[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

# 只扫暂存区（git grep --cached），命中即阻断
hits="$(git grep --cached -nE "$PATTERN" -- . 2>/dev/null || true)"

if [ -n "$hits" ]; then
  echo "✋ 提交被拦截：检测到疑似敏感信息（内网 IP / 密钥 / 私钥）" >&2
  printf '%s\n' "$hits" | sed 's/^/    /' >&2
  echo >&2
  echo "    若是误报或确有需要，可执行：git commit --no-verify" >&2
  exit 1
fi

exit 0
